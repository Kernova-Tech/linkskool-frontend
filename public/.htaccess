Options -Indexes
RewriteEngine On
RewriteBase /

# Force HTTPS
#RewriteCond %{HTTPS} off
#RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Social crawlers don't run JavaScript, so they never see the SPA's meta tags.
# Send them to the API's share page, which carries the article's real Open Graph
# tags. Must stay above the SPA fallback below.
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot) [NC]
RewriteRule ^news/([^/]+)/?$ https://linkskool.net/api/v4/public/news/$1/share [R=302,L]

# Shared forms preview with the form's own title, description and banner.
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot) [NC]
RewriteRule ^f/([A-Za-z0-9]{10})/?$ https://linkskool.net/api/v4/public/forms/$1/share [R=302,L]

# If the request is for an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise, send everything to index.html (for Vue SPA routing)
RewriteRule ^ index.html [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
