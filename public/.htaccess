Options -Indexes
RewriteEngine On
RewriteBase /

# Force HTTPS
#RewriteCond %{HTTPS} off
#RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Social crawlers don't run JavaScript, so they never see the SPA's meta tags.
# Send them to the API's share page, which carries the article's real Open Graph
# tags. Must stay above the SPA fallback below.
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot) [NC]
RewriteRule ^news/([^/]+)/?$ https://linkskool.net/api/v4/public/news/$1/share [R=302,L]

# forms.linkskool.com serves the same build, for forms and staff's task list
# only: the app claims every linkskool.com link, so forms live on a host it
# does not. Anything else asked of it goes to the main site, so the site is
# never served twice.
RewriteCond %{HTTP_HOST} ^forms\.linkskool\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/(f/|tasks/?$|assets/|favicon\.ico$|logo\.svg$|linkskool-banner-logo\.png$|index\.html$)
RewriteRule ^ https://linkskool.com%{REQUEST_URI} [R=301,L]

# leaderboard.linkskool.com: the same build, for leaderboards, badges and
# completion cards only.
RewriteCond %{HTTP_HOST} ^leaderboard\.linkskool\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/(l/|b/|d/|assets/|favicon\.ico$|logo\.svg$|linkskool-banner-logo\.png$|index\.html$)
RewriteRule ^ https://linkskool.com%{REQUEST_URI} [R=301,L]

# A shared badge previews with who won what.
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot) [NC]
RewriteRule ^b/([A-Za-z0-9]{12})/?$ https://linkskool.net/api/v4/public/leaderboards/badge/$1/share [R=302,L]

# A completion card previews with who did which task, and its drawn picture.
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot) [NC]
RewriteRule ^d/([A-Za-z0-9]{12})/?$ https://linkskool.net/api/v4/public/leaderboards/done/$1/share [R=302,L]

# Shared forms preview with the form's own title, description and banner.
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot) [NC]
RewriteRule ^f/([A-Za-z0-9]{10})/?$ https://linkskool.net/api/v4/public/forms/$1/share [R=302,L]

# If the request is for an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise, send everything to index.html (for Vue SPA routing)
RewriteRule ^ index.html [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
